#!/usr/bin/env python3
"""Launch, doctor, and tear down an isolated Fireflies verification stack."""

from __future__ import annotations

import base64
import json
import os
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

REQUIRED_SECRETS = (
    "OPENAI_API_KEY",
    "ASSEMBLYAI_API_KEY",
    "MONGODB_URI",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "REDIS_URL",
    "CLERK_SECRET_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
)

# Local compose values from backend/docker-compose.yml. Used only when the
# secrets file has OPENAI_API_KEY but omits the Docker-backed keys.
COMPOSE_SECRET_DEFAULTS = {
    "MONGODB_URI": (
        "mongodb://fireflies:fireflies@127.0.0.1:27017/fireflies"
        "?authSource=admin&directConnection=true"
    ),
    "REDIS_URL": "redis://127.0.0.1:6379",
    "S3_ENDPOINT": "http://127.0.0.1:9000",
    "S3_ACCESS_KEY": "minioadmin",
    "S3_SECRET_KEY": "minioadmin",
    "S3_BUCKET": "fireflies",
}

SCRIPT_DIR = Path(__file__).resolve().parent
SKILL_DIR = SCRIPT_DIR.parent
REPO_ROOT = SKILL_DIR.parent.parent.parent
RUN_DIR = SKILL_DIR / ".run"
INSTANCE_PATH = RUN_DIR / "instance.json"
SESSION_JWT_PATH = RUN_DIR / "session.jwt"
AGENT_TASK_PATH = RUN_DIR / "agent-task.url"
ARTIFACTS_DIR = SKILL_DIR / "artifacts"
CLERK_API = "https://api.clerk.com/v1"
CLERK_UA = "Mozilla/5.0 (compatible; verify-fireflies/1.0)"
VERIFY_DISPLAY_NAME = "Verify"
BACKEND_DIR = REPO_ROOT / "backend"
FRONTEND_DIR = REPO_ROOT / "frontend"
COMPOSE_FILE = BACKEND_DIR / "docker-compose.yml"

DEFAULT_UI_PORT = 8080
DEFAULT_API_PORT = 3000
VERIFY_MONGO_DB = "fireflies_verify"
VERIFY_S3_BUCKET = "fireflies-verify"
VERIFY_REDIS_DB = "15"


def die(message: str, code: int = 1) -> None:
    print(f"control-fireflies: {message}", file=sys.stderr)
    raise SystemExit(code)


def say(message: str) -> None:
    print(f"control-fireflies: {message}")


def load_dotenv(path: Path) -> dict[str, str]:
    env: dict[str, str] = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if line == "" or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        if key.startswith("export "):
            key = key[len("export ") :].strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
            value = value[1:-1]
        env[key] = value
    return env


def secret_files() -> list[Path]:
    files = [
        REPO_ROOT / ".env",
        BACKEND_DIR / ".env",
        BACKEND_DIR / ".env.local",
        FRONTEND_DIR / ".env.local",
    ]
    override = os.environ.get("FIREFLIES_VERIFY_ENV")
    if override:
        files.append(Path(override))
    return files


def load_secrets() -> dict[str, str]:
    merged: dict[str, str] = {}
    for path in secret_files():
        if path.is_file():
            merged.update(load_dotenv(path))
    for key, value in os.environ.items():
        if value.strip() != "":
            merged[key] = value
    for key, value in COMPOSE_SECRET_DEFAULTS.items():
        if merged.get(key, "").strip() == "":
            merged[key] = value
    missing = [key for key in REQUIRED_SECRETS if merged.get(key, "").strip() == ""]
    if missing:
        die(
            "missing "
            + ", ".join(missing)
            + ". Put them in backend/.env, frontend/.env.local, the process env, "
            "or FIREFLIES_VERIFY_ENV. Do not print those values."
        )
    return merged


def rewrite_mongo_uri(uri: str) -> str:
    parsed = urllib.parse.urlparse(uri)
    return urllib.parse.urlunparse(parsed._replace(path=f"/{VERIFY_MONGO_DB}"))


def rewrite_redis_uri(uri: str) -> str:
    parsed = urllib.parse.urlparse(uri)
    return urllib.parse.urlunparse(parsed._replace(path=f"/{VERIFY_REDIS_DB}"))


def port_from_env(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        value = int(raw)
    except ValueError:
        die(f"{name} must be an integer")
    if value < 1 or value > 65535:
        die(f"{name} is out of range")
    return value


def listener_pids(port: int) -> list[int]:
    try:
        out = subprocess.check_output(
            ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return []
    pids: list[int] = []
    for line in out.split():
        try:
            pids.append(int(line))
        except ValueError:
            continue
    return sorted(set(pids))


def port_is_free(port: int) -> bool:
    return listener_pids(port) == []


def wait_port_free(port: int, timeout: float = 8) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if port_is_free(port):
            return
        time.sleep(0.2)


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def ppid_of(pid: int) -> int | None:
    try:
        out = subprocess.check_output(["ps", "-o", "ppid=", "-p", str(pid)], text=True)
    except subprocess.CalledProcessError:
        return None
    try:
        return int(out.strip())
    except ValueError:
        return None


def group_owns_port(leader_pid: int, port: int) -> bool:
    for pid in listener_pids(port):
        try:
            if pid == leader_pid or os.getpgid(pid) == leader_pid:
                return True
        except OSError:
            pass
        current = pid
        for _ in range(8):
            if current == leader_pid:
                return True
            parent = ppid_of(current)
            if parent is None or parent <= 1:
                break
            current = parent
    return False


def read_instance() -> dict[str, Any]:
    if not INSTANCE_PATH.is_file():
        die("no instance file. Run launch first.", 2)
    return json.loads(INSTANCE_PATH.read_text())


def write_instance(data: dict[str, Any]) -> None:
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    INSTANCE_PATH.write_text(json.dumps(data, indent=2) + "\n")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def http_error_302(self, req, fp, code, msg, headers):  # noqa: ANN001
        raise urllib.error.HTTPError(req.full_url, code, msg, headers, fp)

    http_error_301 = http_error_303 = http_error_307 = http_error_308 = http_error_302


def http_get(
    url: str,
    timeout: float = 5,
    headers: dict[str, str] | None = None,
) -> tuple[int, str]:
    request = urllib.request.Request(url, headers=headers or {}, method="GET")
    opener = urllib.request.build_opener(NoRedirect)
    try:
        with opener.open(request, timeout=timeout) as response:
            body = response.read().decode("utf-8", errors="replace")
            return response.status, body
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        return error.code, body
    except Exception as error:
        return 0, str(error)


def clerk_try(
    secret_key: str,
    method: str,
    path: str,
    body: dict[str, Any] | None = None,
) -> tuple[int, dict[str, Any]]:
    payload = None if body is None else json.dumps(body).encode()
    request = urllib.request.Request(
        f"{CLERK_API}{path}",
        data=payload,
        method=method,
        headers={
            "Authorization": f"Bearer {secret_key}",
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": CLERK_UA,
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            raw = response.read().decode("utf-8", errors="replace")
            status = response.status
    except urllib.error.HTTPError as error:
        raw = error.read().decode("utf-8", errors="replace")
        status = error.code
        if method == "DELETE":
            return status, {}
    if raw == "":
        return status, {}
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        return status, {}
    if not isinstance(parsed, dict):
        return status, {}
    return status, parsed


def clerk_request(secret_key: str, method: str, path: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
    status, parsed = clerk_try(secret_key, method, path, body)
    if method == "DELETE":
        return parsed
    if status >= 400:
        die(f"Clerk {method} {path} -> {status}")
    return parsed


def clerk_frontend_api_host(publishable_key: str) -> str:
    if not publishable_key.startswith(("pk_test_", "pk_live_")):
        return ""
    raw = publishable_key.split("_", 2)[2]
    pad = "=" * ((4 - len(raw) % 4) % 4)
    try:
        decoded = base64.b64decode(raw + pad).decode("utf-8", errors="replace")
    except Exception:
        return ""
    return decoded.split("$")[0].strip()


def require_live_clerk(secrets: dict[str, str]) -> None:
    host = clerk_frontend_api_host(secrets["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"])
    if host == "" or host.startswith("dummy.") or "example" in host or "placeholder" in host:
        die(
            "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is not a live Clerk instance "
            f"(frontend API host {host or 'unreadable'}). "
            "Set the publishable key and CLERK_SECRET_KEY from the same Clerk app, "
            "and allow localhost."
        )
    status, _ = clerk_try(secrets["CLERK_SECRET_KEY"], "GET", "/users?limit=1")
    if status == 401:
        die(
            "CLERK_SECRET_KEY was rejected (401). "
            "Use the secret key from the same Clerk app as the publishable key."
        )
    if status >= 400:
        die(f"Clerk GET /users -> {status}")


def mint_browser_login(secret_key: str, user_id: str, ui_url: str) -> dict[str, str]:
    if user_id == "":
        die("browser login needs clerk_user_id from launch")
    testing_status, testing_body = clerk_try(secret_key, "POST", "/testing_tokens", {})
    testing_token = str(testing_body.get("token", "")) if testing_status in (200, 201) else ""
    ticket_status, ticket_body = clerk_try(
        secret_key,
        "POST",
        "/sign_in_tokens",
        {"user_id": user_id},
    )
    if ticket_status not in (200, 201):
        die(f"Clerk POST /sign_in_tokens -> {ticket_status}")
    ticket = str(ticket_body.get("token", ""))
    ticket_url = str(ticket_body.get("url", ""))
    if ticket == "":
        die("Clerk sign-in token did not return a ticket")
    agent_status, agent_body = clerk_try(
        secret_key,
        "POST",
        "/agents/tasks",
        {
            "on_behalf_of": {"user_id": user_id},
            "permissions": "*",
            "agent_name": "verify-fireflies",
            "task_description": "open the signed-in app",
            "redirect_url": f"{ui_url}/",
        },
    )
    agent_url = str(agent_body.get("url", "")) if agent_status in (200, 201) else ""
    login_url = agent_url or ticket_url or f"{ui_url}/sign-in"
    return {
        "ticket": ticket,
        "testing_token": testing_token,
        "login_url": login_url,
    }


def create_clerk_verify_session(secret_key: str, redirect_url: str) -> dict[str, str]:
    del redirect_url
    email = f"verify-{int(time.time())}+clerk_test@example.com"
    user_id = ""
    try:
        user = clerk_request(
            secret_key,
            "POST",
            "/users",
            {
                "email_address": [email],
                "first_name": VERIFY_DISPLAY_NAME,
                "skip_password_requirement": True,
            },
        )
        user_id = str(user.get("id", ""))
        if user_id == "":
            die("Clerk create user did not return an id")
        session = clerk_request(secret_key, "POST", "/sessions", {"user_id": user_id})
        session_id = str(session.get("id", ""))
        if session_id == "":
            die("Clerk create session did not return an id")
        token = clerk_request(secret_key, "POST", f"/sessions/{session_id}/tokens", {"expires_in_seconds": 3600})
        jwt = str(token.get("jwt", ""))
        if jwt == "":
            die("Clerk session token did not return a jwt")
        return {
            "user_id": user_id,
            "jwt": jwt,
            "display_name": VERIFY_DISPLAY_NAME,
        }
    except BaseException:
        if user_id:
            delete_clerk_user(secret_key, user_id)
        raise


def delete_clerk_user(secret_key: str, user_id: str) -> None:
    if user_id == "":
        return
    clerk_request(secret_key, "DELETE", f"/users/{user_id}")


def wait_http(url: str, timeout: float, ok: tuple[int, ...] = (200,)) -> tuple[int, str]:
    deadline = time.time() + timeout
    last_status = 0
    last_body = ""
    while time.time() < deadline:
        last_status, last_body = http_get(url, timeout=8)
        if last_status in ok:
            return last_status, last_body
        time.sleep(0.5)
    die(f"timed out waiting for {url} (last status {last_status})")
    return last_status, last_body


def parse_health(body: str) -> dict[str, str]:
    try:
        payload = json.loads(body)
    except json.JSONDecodeError:
        return {"status": "unreadable", "blob": "unreadable", "transcribe": "unreadable"}
    if not isinstance(payload, dict):
        return {"status": "unreadable", "blob": "unreadable", "transcribe": "unreadable"}
    services = payload.get("services")
    if not isinstance(services, dict):
        return {
            "status": str(payload.get("status", "unreadable")),
            "blob": "unreadable",
            "transcribe": "unreadable",
        }
    return {
        "status": str(payload.get("status", "error")),
        "blob": str(services.get("blob", "missing")),
        "transcribe": str(services.get("transcribe", "missing")),
    }


def wait_health(url: str, pid: int, timeout: float) -> tuple[int, str]:
    deadline = time.time() + timeout
    last_status = 0
    last_body = ""
    while time.time() < deadline:
        if pid > 0 and not pid_alive(pid):
            die(f"API pid {pid} exited while waiting for {url}")
        last_status, last_body = http_get(url, timeout=8)
        health = parse_health(last_body)
        if last_status in (200, 503) and health["blob"] == "ok":
            return last_status, last_body
        time.sleep(0.5)
    die(f"timed out waiting for {url} blob=ok (last status {last_status})")
    return last_status, last_body


def compose_running() -> bool:
    try:
        out = subprocess.check_output(
            [*docker_cmd(), "compose", "-f", str(COMPOSE_FILE), "ps", "--status", "running", "--services"],
            cwd=BACKEND_DIR,
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False
    services = {line.strip() for line in out.splitlines() if line.strip()}
    return {"mongodb", "redis", "minio"}.issubset(services)


def docker_image_exists(name: str) -> bool:
    try:
        subprocess.check_call(
            [*docker_cmd(), "image", "inspect", name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return False
    return True


def ensure_minio_image() -> None:
    if docker_image_exists("minio/minio:latest"):
        return
    say("docker hub denied minio/minio; pulling quay.io/minio/minio:latest and tagging")
    subprocess.check_call([*docker_cmd(), "pull", "quay.io/minio/minio:latest"])
    subprocess.check_call([*docker_cmd(), "tag", "quay.io/minio/minio:latest", "minio/minio:latest"])


def ensure_compose() -> bool:
    if compose_running():
        return False
    ensure_minio_image()
    say("starting docker compose (mongodb, redis, minio)")
    try:
        subprocess.check_call(
            [*docker_cmd(), "compose", "-f", str(COMPOSE_FILE), "up", "-d", "mongodb", "redis", "minio"],
            cwd=BACKEND_DIR,
        )
    except subprocess.CalledProcessError as error:
        die(f"docker compose up failed ({error.returncode})")
    deadline = time.time() + 180
    while time.time() < deadline:
        if compose_running():
            return True
        time.sleep(1)
    die("docker compose did not become ready")
    return True


def stop_compose() -> None:
    subprocess.check_call(
        [*docker_cmd(), "compose", "-f", str(COMPOSE_FILE), "stop", "mongodb", "redis", "minio"],
        cwd=BACKEND_DIR,
    )


def start_logged(command: list[str], cwd: Path, env: dict[str, str], log_path: Path) -> int:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    handle = log_path.open("w")
    proc = subprocess.Popen(
        command,
        cwd=cwd,
        env=env,
        stdout=handle,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    handle.close()
    return proc.pid


def signal_pid(pid: int, sig: int) -> None:
    try:
        os.killpg(pid, sig)
    except ProcessLookupError:
        return
    except PermissionError:
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return


def kill_pid(pid: int) -> None:
    if pid <= 0 or not pid_alive(pid):
        return
    signal_pid(pid, signal.SIGTERM)
    deadline = time.time() + 8
    while time.time() < deadline:
        if not pid_alive(pid):
            return
        time.sleep(0.2)
    signal_pid(pid, signal.SIGKILL)


def drop_scratch(env: dict[str, str]) -> None:
    mongo_uri = rewrite_mongo_uri(env["MONGODB_URI"])
    try:
        subprocess.run(
            [
                *docker_cmd(),
                "compose",
                "-f",
                str(COMPOSE_FILE),
                "exec",
                "-T",
                "mongodb",
                "mongosh",
                "--quiet",
                mongo_uri.replace("localhost", "127.0.0.1").replace("127.0.0.1", "mongodb"),
                "--eval",
                "db.dropDatabase()",
            ],
            cwd=BACKEND_DIR,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=20,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass
    try:
        subprocess.run(
            [
                *docker_cmd(),
                "compose",
                "-f",
                str(COMPOSE_FILE),
                "exec",
                "-T",
                "redis",
                "redis-cli",
                "-n",
                VERIFY_REDIS_DB,
                "FLUSHDB",
            ],
            cwd=BACKEND_DIR,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass


def bun_bin() -> str:
    home_bun = Path.home() / ".bun/bin/bun"
    candidates = [
        os.environ.get("BUN_INSTALL", "") and str(Path(os.environ["BUN_INSTALL"]) / "bin/bun"),
        str(home_bun),
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return candidate
    try:
        found = subprocess.check_output(["which", "bun"], text=True).strip()
    except subprocess.CalledProcessError:
        found = ""
    if found == "":
        die("bun is not on PATH. Install bun or put it at ~/.bun/bin/bun")
    return found


def docker_cmd() -> list[str]:
    sock = Path("/var/run/docker.sock")
    if sock.exists() and os.access(sock, os.W_OK):
        return ["docker"]
    return ["sudo", "-n", "docker"]


def chrome_bin() -> str:
    for candidate in (
        os.environ.get("CHROME_BIN", ""),
        "/usr/local/bin/google-chrome",
        "/usr/bin/google-chrome-stable",
        "/usr/bin/google-chrome",
        "/usr/bin/chromium",
    ):
        if candidate and Path(candidate).is_file():
            return candidate
    die("google-chrome is not installed; needed for CDP browser-test")
    return ""


def node_bin() -> str:
    found = shutil.which("node")
    if not found:
        die("node is not on PATH; needed for CDP capture")
    return found


class CdpChrome:
    """One Chrome process with --remote-debugging-port for cdp-capture.mjs."""

    def __init__(self) -> None:
        self.proc: subprocess.Popen[bytes] | None = None
        self.profile: Path | None = None
        self.cdp_base = ""
        self.log_path = RUN_DIR / "chrome-cdp.log"

    def __enter__(self) -> CdpChrome:
        self.start()
        return self

    def __exit__(self, *exc: object) -> None:
        self.stop()

    def start(self) -> None:
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        self.profile = RUN_DIR / f"chrome-cdp-{os.getpid()}-{time.time_ns()}"
        self.profile.mkdir(parents=True, exist_ok=True)
        with self.log_path.open("w") as log:
            self.proc = subprocess.Popen(
                [
                    chrome_bin(),
                    "--headless=new",
                    "--disable-gpu",
                    "--no-sandbox",
                    "--disable-dev-shm-usage",
                    "--no-first-run",
                    "--no-default-browser-check",
                    "--remote-debugging-port=0",
                    "--remote-debugging-address=127.0.0.1",
                    "--remote-allow-origins=*",
                    f"--user-data-dir={self.profile}",
                    "--window-size=1440,900",
                    "about:blank",
                ],
                stdout=log,
                stderr=log,
                start_new_session=True,
            )
        time.sleep(0.2)
        if self.proc.poll() is not None:
            die(f"chrome exited {self.proc.returncode}; see {self.log_path}")
        port = self._wait_port()
        self.cdp_base = f"http://127.0.0.1:{port}"
        say(f"cdp {self.cdp_base}")

    def _wait_port(self, timeout: float = 12) -> int:
        assert self.profile is not None
        marker = self.profile / "DevToolsActivePort"
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.proc is not None and self.proc.poll() is not None:
                die(f"chrome exited {self.proc.returncode} before CDP listen; see {self.log_path}")
            if marker.is_file():
                first = marker.read_text().splitlines()[0].strip()
                if first.isdigit():
                    port = int(first)
                    try:
                        with urllib.request.urlopen(
                            f"http://127.0.0.1:{port}/json/version",
                            timeout=1,
                        ) as res:
                            if res.status == 200:
                                return port
                    except OSError:
                        pass
            time.sleep(0.1)
        die(f"Chrome CDP port did not come up; see {self.log_path}")
        return 0

    def stop(self) -> None:
        if self.proc is None:
            return
        pid = self.proc.pid
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            try:
                self.proc.terminate()
            except OSError:
                pass
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(pid, signal.SIGKILL)
            except OSError:
                pass
            try:
                self.proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                pass
        self.proc = None

    def capture(
        self,
        url: str,
        shot: Path,
        html: Path | None = None,
        aria: Path | None = None,
    ) -> None:
        shot.parent.mkdir(parents=True, exist_ok=True)
        cmd = [
            node_bin(),
            str(SCRIPT_DIR / "cdp-capture.mjs"),
            "--cdp",
            self.cdp_base,
            "--url",
            url,
            "--shot",
            str(shot),
        ]
        if html is not None:
            cmd.extend(["--html", str(html)])
        if aria is not None:
            cmd.extend(["--aria", str(aria)])
        try:
            subprocess.run(
                cmd,
                check=True,
                capture_output=True,
                text=True,
                timeout=40,
            )
        except subprocess.TimeoutExpired:
            die(f"CDP capture timed out for {url}")
        except subprocess.CalledProcessError as err:
            detail = (err.stderr or err.stdout or "").strip()
            if detail != "":
                print(detail, file=sys.stderr)
            die(f"CDP capture failed for {url}")
        if not shot.is_file() or shot.stat().st_size < 32:
            die(f"CDP did not write a screenshot for {url}")

    def drive(
        self,
        steps: list[dict[str, Any]],
        ticket: str = "",
        testing_token: str = "",
    ) -> None:
        plan_path = RUN_DIR / "cdp-plan.json"
        plan_path.write_text(
            json.dumps(
                {
                    "cdp": self.cdp_base,
                    "ticket": ticket,
                    "testingToken": testing_token,
                    "steps": steps,
                }
            )
        )
        try:
            subprocess.run(
                [
                    node_bin(),
                    str(SCRIPT_DIR / "cdp-capture.mjs"),
                    "--plan",
                    str(plan_path),
                ],
                check=True,
                capture_output=True,
                text=True,
                timeout=120,
            )
        except subprocess.TimeoutExpired:
            die("CDP plan timed out")
        except subprocess.CalledProcessError as err:
            detail = (err.stderr or err.stdout or "").strip()
            if detail != "":
                print(detail, file=sys.stderr)
            die("CDP plan failed")
        finally:
            plan_path.unlink(missing_ok=True)


def chrome_capture(
    url: str,
    shot: Path,
    html: Path | None = None,
    aria: Path | None = None,
    session: CdpChrome | None = None,
) -> None:
    if session is not None:
        session.capture(url, shot, html, aria)
        return
    with CdpChrome() as cdp:
        cdp.capture(url, shot, html, aria)


def capture_step(shot: Path, html: Path, aria: Path) -> dict[str, Any]:
    shot.parent.mkdir(parents=True, exist_ok=True)
    return {
        "action": "capture",
        "shot": str(shot),
        "html": str(html),
        "aria": str(aria),
    }


def cmd_launch() -> None:
    if not (FRONTEND_DIR / "package.json").is_file() or not (BACKEND_DIR / "package.json").is_file():
        die(f"repo root looks wrong: {REPO_ROOT}")
    if INSTANCE_PATH.is_file():
        existing = json.loads(INSTANCE_PATH.read_text())
        ui_pid = int(existing.get("ui_pid", 0))
        api_pid = int(existing.get("api_pid", 0))
        if pid_alive(ui_pid) or pid_alive(api_pid):
            die("a verification instance is already running. Run cleanup first.")
        INSTANCE_PATH.unlink()

    ui_port = port_from_env("FIREFLIES_UI_PORT", DEFAULT_UI_PORT)
    api_port = port_from_env("FIREFLIES_API_PORT", DEFAULT_API_PORT)
    if not port_is_free(ui_port):
        die(f"UI port {ui_port} is already in use")
    if not port_is_free(api_port):
        die(f"API port {api_port} is already in use")

    secrets = load_secrets()
    require_live_clerk(secrets)
    bun = bun_bin()
    if not (FRONTEND_DIR / "node_modules").is_dir():
        say("bun install in frontend/")
        subprocess.check_call([bun, "install"], cwd=FRONTEND_DIR)
    if not (BACKEND_DIR / "node_modules").is_dir():
        say("bun install in backend/")
        subprocess.check_call([bun, "install"], cwd=BACKEND_DIR)
    next_bin = FRONTEND_DIR / "node_modules/next/dist/bin/next"
    if not next_bin.is_file():
        die(f"missing {next_bin}. Run bun install in frontend/")

    api_env = dict(os.environ)
    api_env.update(secrets)
    api_env["PORT"] = str(api_port)
    api_env["MONGODB_URI"] = rewrite_mongo_uri(secrets["MONGODB_URI"])
    api_env["REDIS_URL"] = rewrite_redis_uri(secrets["REDIS_URL"])
    api_env["S3_BUCKET"] = VERIFY_S3_BUCKET
    api_env["FRONTEND_ORIGIN"] = f"http://localhost:{ui_port}"

    ui_env = dict(os.environ)
    ui_env["API_URL"] = f"http://127.0.0.1:{api_port}"
    ui_env["PORT"] = str(ui_port)
    if ui_port != 8080:
        ui_env["NEXT_DIST_DIR"] = ".next-verify"
    ui_env["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"] = secrets["NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY"]
    ui_env["CLERK_SECRET_KEY"] = secrets["CLERK_SECRET_KEY"]

    ARTIFACTS_DIR.mkdir(parents=True, exist_ok=True)
    RUN_DIR.mkdir(parents=True, exist_ok=True)

    api_log = RUN_DIR / "api.log"
    ui_log = RUN_DIR / "ui.log"
    api_pid = 0
    ui_pid = 0
    started_compose = False
    instance_written = False
    clerk_user_id = ""
    try:
        started_compose = ensure_compose()
        say(f"starting API on {api_port}")
        api_pid = start_logged(
            [bun, "src/server.ts"],
            BACKEND_DIR,
            api_env,
            api_log,
        )
        wait_health(f"http://127.0.0.1:{api_port}/health", api_pid, timeout=90)
        say(f"starting UI on {ui_port}")
        ui_pid = start_logged(
            [bun, str(next_bin), "dev", "-p", str(ui_port), "--hostname", "localhost"],
            FRONTEND_DIR,
            ui_env,
            ui_log,
        )
        time.sleep(1)
        if not pid_alive(ui_pid):
            die(f"UI exited. See {ui_log}")
        ui_url = f"http://localhost:{ui_port}"
        wait_http(f"{ui_url}/sign-in", timeout=90)
        clerk_user_id = ""
        display_name = VERIFY_DISPLAY_NAME
        session_state = "missing"
        say("creating Clerk verify session")
        session = create_clerk_verify_session(secrets["CLERK_SECRET_KEY"], f"{ui_url}/")
        clerk_user_id = session["user_id"]
        SESSION_JWT_PATH.write_text(session["jwt"])
        AGENT_TASK_PATH.unlink(missing_ok=True)
        display_name = session["display_name"]
        session_state = "ready"
        write_instance(
            {
                "ui_pid": ui_pid,
                "api_pid": api_pid,
                "ui_port": ui_port,
                "api_port": api_port,
                "ui_url": ui_url,
                "api_url": f"http://127.0.0.1:{api_port}",
                "health_url": f"http://127.0.0.1:{api_port}/health",
                "sign_in_url": f"{ui_url}/sign-in",
                "started_compose": started_compose,
                "mongo_db": VERIFY_MONGO_DB,
                "s3_bucket": VERIFY_S3_BUCKET,
                "redis_db": int(VERIFY_REDIS_DB),
                "clerk_user_id": clerk_user_id,
                "display_name": display_name,
                "session": session_state,
            }
        )
        instance_written = True
    finally:
        if not instance_written:
            if clerk_user_id:
                delete_clerk_user(secrets["CLERK_SECRET_KEY"], clerk_user_id)
            SESSION_JWT_PATH.unlink(missing_ok=True)
            AGENT_TASK_PATH.unlink(missing_ok=True)
            kill_pid(ui_pid)
            kill_pid(api_pid)
            if started_compose:
                stop_compose()

    say(f"ready UI={ui_port} API={api_port} pids ui={ui_pid} api={api_pid}")
    say(f"ui_url=http://localhost:{ui_port}")
    say(f"health_url=http://127.0.0.1:{api_port}/health")
    say(f"sign_in_url=http://localhost:{ui_port}/sign-in")
    say(f"display_name={VERIFY_DISPLAY_NAME} session={session_state}")


def cmd_doctor() -> None:
    instance = read_instance()
    ui_pid = int(instance["ui_pid"])
    api_pid = int(instance["api_pid"])
    ui_port = int(instance["ui_port"])
    api_port = int(instance["api_port"])
    ui_url = str(instance["ui_url"])
    api_url = str(instance["api_url"])
    problems: list[str] = []

    if not pid_alive(ui_pid):
        problems.append(f"UI pid {ui_pid} is dead")
    if not pid_alive(api_pid):
        problems.append(f"API pid {api_pid} is dead")
    ui_listeners = listener_pids(ui_port)
    api_listeners = listener_pids(api_port)
    if not group_owns_port(ui_pid, ui_port):
        problems.append(f"UI pid {ui_pid} does not own port {ui_port} (owners {ui_listeners})")
    if not group_owns_port(api_pid, api_port):
        problems.append(f"API pid {api_pid} does not own port {api_port} (owners {api_listeners})")

    health_status, health_body = http_get(f"{api_url}/health", timeout=15)
    health = parse_health(health_body)
    if health_status not in (200, 503):
        problems.append(f"GET {api_url}/health -> {health_status}")
    elif health["blob"] != "ok":
        problems.append(f"API blob is not ok: {health_body[:200]}")

    sign_in_status, sign_in_body = http_get(f"{ui_url}/sign-in", timeout=15)
    if sign_in_status != 200:
        problems.append(f"GET {ui_url}/sign-in -> {sign_in_status}")

    ui_status, _ = http_get(f"{ui_url}/", timeout=10)
    if ui_status not in (301, 302, 303, 307, 308):
        problems.append(f"GET {ui_url}/ without session -> {ui_status} (want redirect to sign-in)")

    unsigned_meetings, _ = http_get(f"{ui_url}/api/meetings?page=1&limit=5", timeout=10)
    if unsigned_meetings not in (401, 302, 303, 307, 308):
        problems.append(f"GET {ui_url}/api/meetings without session -> {unsigned_meetings}")

    jwt = SESSION_JWT_PATH.read_text().strip() if SESSION_JWT_PATH.is_file() else ""
    session_state = "ready" if jwt != "" else "missing"
    meetings_status = 0
    meetings_body = ""
    if jwt != "":
        meetings_status, meetings_body = http_get(
            f"{api_url}/meetings?page=1&limit=5",
            timeout=15,
            headers={"Authorization": f"Bearer {jwt}"},
        )
        if meetings_status != 200:
            problems.append(f"GET {api_url}/meetings with Bearer -> {meetings_status}")
        else:
            try:
                payload = json.loads(meetings_body)
            except json.JSONDecodeError:
                problems.append("meetings API did not return JSON")
                payload = None
            if isinstance(payload, dict) and "items" not in payload:
                problems.append("meetings API JSON has no items")
    if session_state != "ready":
        problems.append("session=missing; launch needs live Clerk keys")
    if str(instance.get("clerk_user_id", "")).strip() == "":
        problems.append("clerk_user_id is empty")

    print(f"ui_url={ui_url}")
    print(f"api_url={api_url}")
    print(f"health_url={api_url}/health")
    print(f"sign_in_url={ui_url}/sign-in")
    print(f"ui_pid={ui_pid}")
    print(f"api_pid={api_pid}")
    print(f"mongo_db={instance.get('mongo_db')}")
    print(f"s3_bucket={instance.get('s3_bucket')}")
    print(f"redis_db={instance.get('redis_db')}")
    print(f"started_compose={instance.get('started_compose')}")
    print(f"display_name={instance.get('display_name')}")
    print(f"health_http={health_status}")
    print(f"blob={health['blob']}")
    print(f"transcribe={health['transcribe']}")
    print(f"session={session_state}")
    print(f"artifacts={ARTIFACTS_DIR}")
    if problems:
        for problem in problems:
            print(f"FAIL {problem}")
        raise SystemExit(1)
    print("doctor=ok")


def cmd_status() -> None:
    if not INSTANCE_PATH.is_file():
        print("instance=none")
        raise SystemExit(0)
    instance = json.loads(INSTANCE_PATH.read_text())
    print(json.dumps(instance, indent=2))


def cmd_cleanup() -> None:
    if not INSTANCE_PATH.is_file():
        say("nothing to clean")
        return
    instance = json.loads(INSTANCE_PATH.read_text())
    ui_pid = int(instance.get("ui_pid", 0))
    api_pid = int(instance.get("api_pid", 0))
    ui_port = int(instance.get("ui_port", DEFAULT_UI_PORT))
    api_port = int(instance.get("api_port", DEFAULT_API_PORT))
    say(f"stopping pids ui={ui_pid} api={api_pid}")
    kill_pid(ui_pid)
    kill_pid(api_pid)
    wait_port_free(ui_port)
    wait_port_free(api_port)
    try:
        secrets = load_secrets()
        delete_clerk_user(secrets["CLERK_SECRET_KEY"], str(instance.get("clerk_user_id", "")))
        drop_scratch(secrets)
    except SystemExit:
        say("scratch db drop skipped (no secrets file)")
    if instance.get("started_compose") is True:
        say("stopping docker compose that launch started")
        stop_compose()
    INSTANCE_PATH.unlink(missing_ok=True)
    SESSION_JWT_PATH.unlink(missing_ok=True)
    AGENT_TASK_PATH.unlink(missing_ok=True)
    say(f"cleanup done; artifacts kept at {ARTIFACTS_DIR}")


def cmd_sample_video() -> None:
    dest = Path(os.environ.get("FIREFLIES_VERIFY_VIDEO", str(RUN_DIR / "sample.mp4")))
    dest.parent.mkdir(parents=True, exist_ok=True)
    subprocess.check_call(
        [
            "ffmpeg",
            "-y",
            "-f",
            "lavfi",
            "-i",
            "testsrc=duration=2:size=320x240:rate=10",
            "-f",
            "lavfi",
            "-i",
            "sine=frequency=1000:duration=2",
            "-pix_fmt",
            "yuv420p",
            "-shortest",
            str(dest),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    print(str(dest))


def cmd_sample_audio() -> None:
    dest = Path(os.environ.get("FIREFLIES_VERIFY_AUDIO", str(RUN_DIR / "sample.mp3")))
    dest.parent.mkdir(parents=True, exist_ok=True)
    subprocess.check_call(
        [
            "ffmpeg",
            "-y",
            "-f",
            "lavfi",
            "-i",
            "sine=frequency=1000:duration=2",
            "-q:a",
            "9",
            str(dest),
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    print(str(dest))


def cmd_session() -> None:
    instance = read_instance()
    print(f"display_name={instance.get('display_name', VERIFY_DISPLAY_NAME)}")
    print("cookie_name=__session")
    print(f"cookie_file={SESSION_JWT_PATH}")
    print(f"agent_task_file={AGENT_TASK_PATH}")


def cmd_snapshot() -> None:
    instance = read_instance()
    if str(instance.get("session", "")) != "ready":
        die("snapshot needs session=ready. Launch with live Clerk keys.")
    feature = "home"
    path = "/"
    if len(sys.argv) >= 3:
        feature = sys.argv[2]
    if len(sys.argv) >= 4:
        path = sys.argv[3]
        if not path.startswith("/"):
            die("snapshot path must start with /")
    dest = ARTIFACTS_DIR / feature
    dest.mkdir(parents=True, exist_ok=True)
    ui_url = str(instance["ui_url"]).rstrip("/")
    start_url = f"{ui_url}{path}"
    secrets = load_secrets()
    login = mint_browser_login(
        secrets["CLERK_SECRET_KEY"],
        str(instance.get("clerk_user_id", "")),
        ui_url,
    )
    shot = dest / "shot.png"
    html = dest / "shot.html"
    aria = dest / "shot.aria.txt"
    say(f"snapshot feature={feature} url={start_url}")
    with CdpChrome() as cdp:
        cdp.drive(
            [
                {"action": "goto", "url": f"{ui_url}/sign-in"},
                {"action": "signInTicket"},
                {"action": "goto", "url": start_url},
                {"action": "waitMs", "ms": 800},
                capture_step(shot, html, aria),
            ],
            ticket=login["ticket"],
            testing_token=login["testing_token"],
        )
    print(f"shot={shot}")
    print(f"aria={aria}")


def cmd_browser_test() -> None:
    instance = read_instance()
    if str(instance.get("session", "")) != "ready":
        die("browser-test needs session=ready. Launch with live Clerk keys.")
    secrets = load_secrets()
    ui_url = str(instance["ui_url"]).rstrip("/")
    api_url = str(instance["api_url"]).rstrip("/")
    health_url = f"{api_url}/health"
    sign_in_url = f"{ui_url}/sign-in"
    stack = ARTIFACTS_DIR / "stack"
    home = ARTIFACTS_DIR / "home"
    meetings = ARTIFACTS_DIR / "meetings-list"
    tasks = ARTIFACTS_DIR / "tasks"
    fred = ARTIFACTS_DIR / "ask-fred"
    for dest in (stack, home, meetings, tasks, fred):
        dest.mkdir(parents=True, exist_ok=True)
    problems: list[str] = []

    print("harness=cdp")
    print("login=clerk-ticket")
    print(f"open {sign_in_url}")
    print(f"open {ui_url}/")
    print(f"open {ui_url}/meetings")
    print(f"open {ui_url}/tasks")
    print(f"open {health_url}")

    health_status, health_body = http_get(health_url, timeout=15)
    (stack / "health.json").write_text(health_body)
    health = parse_health(health_body)
    if health_status not in (200, 503) or health["blob"] != "ok":
        problems.append(f"API health blob not ok http={health_status}")

    sign_status, _ = http_get(sign_in_url, timeout=15)
    if sign_status != 200:
        problems.append(f"UI /sign-in -> {sign_status}")
    home_status, _ = http_get(f"{ui_url}/", timeout=10)
    if home_status not in (301, 302, 303, 307, 308):
        problems.append(f"UI / -> {home_status} (want redirect)")

    jwt = SESSION_JWT_PATH.read_text().strip() if SESSION_JWT_PATH.is_file() else ""
    if jwt == "":
        problems.append("session jwt missing")
    else:
        meetings_status, meetings_body = http_get(
            f"{api_url}/meetings?page=1&limit=5",
            timeout=15,
            headers={"Authorization": f"Bearer {jwt}"},
        )
        (meetings / "empty.json").write_text(meetings_body)
        if meetings_status != 200:
            problems.append(f"API /meetings with Bearer -> {meetings_status}")

    login = mint_browser_login(
        secrets["CLERK_SECRET_KEY"],
        str(instance.get("clerk_user_id", "")),
        ui_url,
    )

    with CdpChrome() as cdp:
        print(f"cdp={cdp.cdp_base}")
        cdp.drive(
            [
                {"action": "goto", "url": health_url},
                {"action": "waitText", "text": '"blob":"ok"', "timeoutMs": 15000},
                capture_step(stack / "health.png", stack / "health.html", stack / "health.aria.txt"),
                {"action": "goto", "url": sign_in_url},
                {"action": "waitPath", "path": "/sign-in"},
                {"action": "waitMs", "ms": 800},
                capture_step(
                    stack / "sign-in.png",
                    stack / "sign-in.html",
                    stack / "sign-in.aria.txt",
                ),
                {"action": "signInTicket"},
                {"action": "goto", "url": f"{ui_url}/"},
                {"action": "waitPath", "path": "/", "exact": True, "timeoutMs": 25000},
                {"action": "waitText", "text": "Verify", "timeoutMs": 25000},
                {"action": "waitText", "text": "Good ", "timeoutMs": 20000},
                capture_step(home / "home.png", home / "home.html", home / "home.aria.txt"),
                {"action": "click", "name": "Meetings"},
                {"action": "waitPath", "path": "/meetings", "timeoutMs": 15000},
                {"action": "waitText", "text": "Capture your first meeting", "timeoutMs": 20000},
                capture_step(
                    meetings / "empty.png",
                    meetings / "empty.html",
                    meetings / "empty.aria.txt",
                ),
                {"action": "click", "name": "Tasks"},
                {"action": "waitPath", "path": "/tasks", "timeoutMs": 15000},
                {"action": "waitText", "text": "Capture your first meeting", "timeoutMs": 20000},
                capture_step(tasks / "empty.png", tasks / "empty.html", tasks / "empty.aria.txt"),
                {"action": "click", "name": "AskFred"},
                {"action": "waitText", "text": "Hi Verify!", "timeoutMs": 20000},
                capture_step(fred / "open.png", fred / "open.html", fred / "open.aria.txt"),
                {"action": "click", "name": "Close AskFred"},
                {"action": "click", "name": "Home"},
                {"action": "waitPath", "path": "/", "exact": True, "timeoutMs": 15000},
                capture_step(stack / "root.png", stack / "root.html", stack / "root.aria.txt"),
            ],
            ticket=login["ticket"],
            testing_token=login["testing_token"],
        )

    home_text = (home / "home.aria.txt").read_text() if (home / "home.aria.txt").is_file() else ""
    home_html = (home / "home.html").read_text() if (home / "home.html").is_file() else ""
    if "Verify" not in home_text and "Verify" not in home_html:
        problems.append("signed-in Home did not show Verify")
    if "Good " not in home_text and "Good " not in home_html:
        problems.append("signed-in Home did not show the greeting")
    meetings_text = (
        (meetings / "empty.aria.txt").read_text() if (meetings / "empty.aria.txt").is_file() else ""
    )
    if "Capture your first meeting" not in meetings_text:
        problems.append("Meetings empty copy missing after Clerk login")
    fred_text = (fred / "open.aria.txt").read_text() if (fred / "open.aria.txt").is_file() else ""
    if "Hi Verify!" not in fred_text:
        problems.append("AskFred did not greet Verify")

    notes = stack / "notes.md"
    notes.write_text(
        "\n".join(
            [
                "# Stack browser test",
                "",
                "- harness: cdp",
                "- login: clerk-ticket",
                f"- ui_url: {ui_url}",
                f"- sign_in_url: {sign_in_url}",
                f"- health_url: {health_url}",
                f"- health_http: {health_status}",
                f"- blob: {health['blob']}",
                f"- transcribe: {health['transcribe']}",
                f"- sign_in_http: {sign_status}",
                f"- root_http: {home_status}",
                f"- problems: {', '.join(problems) if problems else 'none'}",
                "",
            ]
        )
        + "\n"
    )
    if problems:
        for problem in problems:
            print(f"FAIL {problem}")
        raise SystemExit(1)
    print("browser-test=ok")


def usage() -> None:
    die(
        "usage: control-fireflies launch|doctor|status|session|browser-test|snapshot|cleanup|sample-video|sample-audio",
        2,
    )


def main() -> None:
    if len(sys.argv) < 2:
        usage()
    command = sys.argv[1]
    if command == "launch":
        cmd_launch()
    elif command == "doctor":
        cmd_doctor()
    elif command == "status":
        cmd_status()
    elif command == "session":
        cmd_session()
    elif command == "browser-test":
        cmd_browser_test()
    elif command == "snapshot":
        cmd_snapshot()
    elif command == "cleanup":
        cmd_cleanup()
    elif command == "sample-video":
        cmd_sample_video()
    elif command == "sample-audio":
        cmd_sample_audio()
    else:
        usage()


if __name__ == "__main__":
    main()
