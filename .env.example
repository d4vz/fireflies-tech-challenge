# Copy to .env in this directory, then:
#   docker compose up --build
#
# One file. Compose injects each key into the service that needs it.
# OpenAI and AssemblyAI stay on the backend. Clerk is shared.

# --- Backend only ---
# Summaries, embeddings, and AskFred (OpenAI).
OPENAI_API_KEY=sk-proj-your-openai-key

# Transcription with speaker labels (AssemblyAI).
ASSEMBLYAI_API_KEY=your-assemblyai-key

# --- Frontend + backend, same Clerk application ---
# Frontend (browser): ClerkProvider and the sign-in UI.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Frontend (Next.js server): session, auth.protect, getToken.
# Backend (Hono): verify the JWT on every API request after /health.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Optional. Browser origin for CORS. Compose defaults to this.
# FRONTEND_ORIGIN=http://localhost:8080
